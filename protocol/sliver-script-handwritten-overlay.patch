+ */
+export function rpcTlsAuthorityOverride(host: string, throughProxy: boolean): string | undefined {
+  const normalized = host.trim().replace(/^\[|\]$/gu, "");
+  if (isIP(normalized) !== 0) return IP_LITERAL_TLS_AUTHORITY;
