{
  "name": "sliver-gui",
  "version": "0.1.0",
  "private": true,
  "description": "Cross-platform Electron operator console for Sliver",
  "license": "GPL-3.0-or-later",
  "author": {
    "name": "Sliver Armory",
    "email": "sliverarmory@users.noreply.github.com"
  },
  "homepage": "https://github.com/sliverarmory/sliver-gui#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/sliverarmory/sliver-gui.git"
  },
  "main": "dist/main/index.js",
  "type": "module",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": "^24.15.0 || >=26.0.0",
    "npm": ">=11.19.0"
  },
  "scripts": {
    "build:console": "node ./scripts/buildSliverConsole.mjs",
    "build:e2e-app": "npm run prepare:node-pty && npm run build && node ./scripts/cleanE2EOutput.mjs && tsc -p tsconfig.e2e.json",
    "build:licenses": "node ./scripts/generateThirdPartyLicenses.mjs",
    "dev": "npm run build && electron-vite preview --skipBuild",
    "predev": "npm run prepare:node-pty",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "build": "npm run typecheck && electron-vite build",
    "pretest": "npm run prepare:node-pty",
    "test": "vitest run",
    "test:e2e:electron": "npm run build:e2e-app && node --test --test-concurrency=1 .e2e-dist/src/e2e/application-protocol.e2e.js .e2e-dist/src/e2e/application-navigation.e2e.js .e2e-dist/src/e2e/window-navigation.e2e.js .e2e-dist/src/e2e/keyboard-shortcuts.e2e.js .e2e-dist/src/e2e/application-icon.e2e.js .e2e-dist/src/e2e/electron-current-slice.e2e.js .e2e-dist/src/e2e/session-registry-layout.e2e.js .e2e-dist/src/e2e/session-files-layout.e2e.js .e2e-dist/src/e2e/session-network.e2e.js .e2e-dist/src/e2e/network-window.e2e.js .e2e-dist/src/e2e/armory-window.e2e.js .e2e-dist/src/e2e/auxiliary-context-menu.e2e.js .e2e-dist/src/e2e/overview.e2e.js .e2e-dist/src/e2e/overview-topology.e2e.js .e2e-dist/src/e2e/script-editor.e2e.js",
    "test:e2e:navigation": "npm run build:e2e-app && node --test .e2e-dist/src/e2e/application-navigation.e2e.js",
    "test:e2e:window-navigation": "npm run build:e2e-app && node --test .e2e-dist/src/e2e/window-navigation.e2e.js",
    "test:e2e:protocol": "npm run build:e2e-app && node --test .e2e-dist/src/e2e/application-protocol.e2e.js",
    "test:e2e:overview": "npm run build:e2e-app && node --test --test-concurrency=1 .e2e-dist/src/e2e/overview.e2e.js .e2e-dist/src/e2e/overview-topology.e2e.js",
    "test:e2e:registry": "npm run build:e2e-app && node --test .e2e-dist/src/e2e/session-registry-layout.e2e.js",
    "test:e2e:files": "npm run build:e2e-app && node --test .e2e-dist/src/e2e/session-files-layout.e2e.js",
    "test:e2e:icons": "npm run build:e2e-app && node --test .e2e-dist/src/e2e/application-icon.e2e.js",
    "test:e2e:m1": "npm run test:e2e:electron",
    "test:e2e:packaged": "node ./scripts/cleanE2EOutput.mjs && tsc -p tsconfig.e2e.json && npm run verify:packaged-content && node --test .e2e-dist/src/e2e/packaged-mtls.e2e.js",
    "test:e2e:packaged-update": "node ./scripts/cleanE2EOutput.mjs && tsc -p tsconfig.e2e.json && node --test .e2e-dist/src/e2e/packaged-application-update.e2e.js",
    "test:e2e:packaged-real": "node ./scripts/requireRealServerE2EEnv.mjs && node ./scripts/cleanE2EOutput.mjs && tsc -p tsconfig.e2e.json && npm run verify:packaged-content && node --test .e2e-dist/src/e2e/packaged-real-server.e2e.js",
    "test:e2e:packaged-real-m1": "node ./scripts/requireM1RealServerE2EEnv.mjs && node ./scripts/cleanE2EOutput.mjs && tsc -p tsconfig.e2e.json && npm run verify:packaged-content && node --test .e2e-dist/src/e2e/packaged-real-m1.e2e.js",
    "test:e2e:packaged-real-m3": "node ./scripts/cleanE2EOutput.mjs && tsc -p tsconfig.e2e.json && npm run verify:packaged-content && node --test .e2e-dist/src/e2e/packaged-real-m3.e2e.js",
    "test:m0": "npm test && npm run test:e2e:electron && npm run package && npm run test:e2e:packaged",
    "test:watch": "vitest",
    "protocol:check": "node ./scripts/protocol-check.mjs",
    "protocol:fetch": "node ./scripts/protocol-fetch-baseline.mjs",
    "protocol:client": "node ./scripts/protocol-verify-client-package.mjs",
    "protocol:ghostty": "node ./scripts/verifyGhosttyRuntime.mjs",
    "parity:generate": "node ./scripts/parity-generate.mjs",
    "parity:check": "node ./scripts/parity-check.mjs",
    "prepare:node-pty": "node ./scripts/prepareNodePtyRuntime.mjs",
    "verify:release-version": "node ./scripts/verifyReleaseVersion.mjs",
    "verify:release-signing-env": "node ./scripts/verifyReleaseSigningEnvironment.mjs",
    "verify:update-artifacts": "node ./scripts/verifyUpdateArtifacts.mjs",
    "verify:release-content": "node ./scripts/verifyReleaseContent.mjs",
    "verify:packaged-content": "node ./scripts/verifyReleaseContent.mjs --packaged",
    "prepackage": "npm run build:licenses && npm run prepare:node-pty && npm run build:console",
    "package": "npm run build && npm run verify:release-content && electron-builder --dir && npm run verify:packaged-content",
    "predist": "npm run build:licenses && npm run prepare:node-pty && npm run build:console && npm run build && npm run verify:release-content",
    "dist": "electron-builder",
    "postdist": "npm run verify:packaged-content",
    "test:e2e:scripts": "npm run build:e2e-app && node --test .e2e-dist/src/e2e/script-editor.e2e.js"
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "@fortawesome/fontawesome-svg-core": "7.3.1",
    "@fortawesome/free-brands-svg-icons": "7.3.1",
    "@fortawesome/free-solid-svg-icons": "7.3.1",
    "@fortawesome/react-fontawesome": "3.5.0",
    "@grpc/grpc-js": "1.14.4",
    "@heroui-pro/react": "1.0.0-beta.8",
    "@heroui/react": "3.2.4",
    "@heroui/styles": "3.2.4",
    "@internationalized/date": "^3.12.3",
    "@react-aria/i18n": "^3.13.1",
    "@react-aria/ssr": "^3.10.1",
    "@react-aria/utils": "^3.34.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.3",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/ssh2": "1.15.6",
    "@vitejs/plugin-react": "5.2.0",
    "@xyflow/react": "12.11.6",
    "electron": "43.3.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "elkjs": "0.12.0",
    "jsdom": "30.0.1",
    "motion": "13.0.0",
    "nice-grpc": "2.1.17",
    "playwright-core": "1.62.1",
    "react": "19.2.8",
    "react-aria": "^3.51.0",
    "react-aria-components": "^1.20.0",
    "react-dom": "19.2.8",
    "react-resizable-panels": "4.12.2",
    "rxjs": "7.8.2",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "7.3.6",
    "vitest": "4.1.10"
  },
  "overrides": {
    "tar": "7.5.22",
    "monaco-editor": {
      "dompurify": "3.4.15"
    }
  },
  "allowScripts": {
    "@heroui-pro/react@1.0.0-beta.8": true,
    "@zowe/secrets-for-zowe-sdk": false,
    "cpu-features@0.0.10": false,
    "electron-winstaller@5.4.0": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true,
    "fsevents": false,
    "node-pty@1.1.0": true,
    "protobufjs": false,
    "ssh2@1.17.0": false
  },
  "dependencies": {
    "@aws-sdk/client-ec2": "3.1127.0",
    "@aws-sdk/credential-providers": "3.1127.0",
    "@azure/arm-compute": "25.1.1",
    "@azure/arm-network": "38.0.0",
    "@azure/arm-resources": "8.0.0",
    "@azure/core-process": "1.0.0",
    "@azure/identity": "4.13.2",
    "@azure/msal-node": "5.6.0",
    "@noble/hashes": "2.3.0",
    "electron-updater": "6.8.9",
    "ghostty-web": "0.4.0",
    "monaco-editor": "0.56.0",
    "node-pty": "1.1.0",
    "quickjs-emscripten": "0.32.0",
    "sliver-script": "2.0.0-rc.5",
    "ssh2": "1.17.0"
  }
}
